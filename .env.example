# ==========================================
# Orvian Environment Configuration Template
# ==========================================
# Copy this file to .env at the repository root and fill in real values. Never commit .env.

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Neon PostgreSQL Database Configuration ---
# Runtime database URL (Neon pooled connection string, e.g. ep-placeholder-pooler.us-east-2.aws.neon.tech)
DATABASE_URL=postgresql+psycopg://username:password@ep-placeholder-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct database URL for Alembic migrations (Neon unpooled connection string, e.g. ep-placeholder.us-east-2.aws.neon.tech)
DIRECT_DATABASE_URL=postgresql+psycopg://username:password@ep-placeholder.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_TIMEOUT=30

# --- Authentication & Session Security (Planned for Post-Setup) ---
# Generate with: openssl rand -hex 32
AUTH_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
AUTH_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_COOKIE_NAME=orvian_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Google OAuth2 Credentials (Planned for Post-Setup)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# SMTP Email Configuration (Planned for Post-Setup)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@orvian.local
SMTP_FROM_NAME="Orvian Assistant"

# --- AI & Retrieval Configuration (Planned for Post-Setup) ---
OPENAI_API_KEY=your-openai-api-key
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
